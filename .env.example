# Скопируйте в .env и заполните. Без LLM_API_KEY сервис работает в режиме rules (тот же агентный цикл без LLM).

# Шлюз организаторов (OpenAI-совместимый /chat/completions)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODE=auto                     # auto | llm | rules
LLM_DAILY_TOKEN_LIMIT=400000      # защита дневного бюджета (500 руб.)

# Имена моделей так, как их называет шлюз (только модели из списка кейса)
MODEL_EXTRACT=gemma-4-26b-a4b
MODEL_REASON=glm-5.3-flash
MODEL_CRITIC=qwen3.6-35b-a3b
MODEL_LINKS=deepseek-v4.1-flash
MODEL_VISION=qwen3-vl-30b-a3b-instruct
MODEL_CHAT=kimi-k2.6

# Данные и режим демо
ALFA_TODAY=2026-09-15             # «сегодня» для демо: аналитика банка датирована сентябрем 2026
ALFA_RAW_DIR=data/raw             # CSV кейса для python -m app.cli build-profiles
FETCH_NEWS=0                      # 1 = фоновый сбор RSS (ЦБ, Интерфакс, ТАСС, РБК, Коммерсантъ)
FETCH_INTERVAL_MIN=15
FEED_SIZE=7
FEED_THRESHOLD=0.08
STALE_RESEARCH_DAYS=180
